{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "plugins": [
    "@mohak34/opencode-notifier@latest",
    "./plugins/herdr-session"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true
}
