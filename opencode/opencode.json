{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["@mohak34/opencode-notifier@latest", "opencode-cmux"],
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "buildkite": {
      "type": "remote",
      "url": "https://mcp.buildkite.com/mcp"
    }
  },
  "autoshare": false
