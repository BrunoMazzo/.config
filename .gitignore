tmux/plugins
yarn/global/**
raycast/extensions
github-copilot
jgit
.DS_Store
/gcloud
/gws
Brewfile.lock.json

# OpenCode local secrets and runtime state
/opencode/service.json
/opencode/opencode-notifier-state.json
/opencode/package-lock.json

# Herdr app/core: generated home, logs, sockets and runtime state
/herdr/
/herdr-app/*
!/herdr-app/settings.json
!/herdr-app/keys.json
!/herdr-app/layouts/
!/herdr-app/themes/

# Personal Herdr mods (the app regenerates everything else)
!/herdr-app/mods/
/herdr-app/mods/*
!/herdr-app/mods/spaces-agents/
/herdr-app/mods/spaces-agents/gpui-kit.d.ts
/herdr-app/mods/spaces-agents/jsconfig.json
!/herdr-app/mods/space-menu/
/herdr-app/mods/space-menu/gpui-kit.d.ts
/herdr-app/mods/space-menu/jsconfig.json

# Other app/runtime state
/1Password/
/openspec/
/cmux/
/package-lock.json
